# ✅ ❌ #

# set -e              — po błędzie dowolnej komendy (status != 0) skrypt się kończy (errexit).
# set -o pipefail     — `-o` + nazwa opcji: w potoku `a | b | c` błąd w dowolnym etapie daje
#                       niezerowy status całego potoku (bez tego liczy się tylko ostatnia komenda).
# set -x              — przed wykonaniem każdej linii wypisuje rozwiniętą komendę (ślad / debug).

set -eo pipefail
# set -x

PACKAGES=(
    tar
    make
    cmake
    ninja-build
    build-essential
    gcc-arm-none-eabi
    libnewlib-arm-none-eabi
    libstdc++-arm-none-eabi-newlib
    git
    python3
    ca-certificates
    docker-compose-v2
    docker
)

export DIR_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && realpath .)"
_img_path="${DIR_ROOT#/}"
_filter="$(printf '%s' "$_img_path" | LC_ALL=C tr -c 'a-zA-Z0-9' '-' | tr -s '-')"
export DOCKER_IMG_PREFIX="${_filter,,}---"

export DIR_TARGET="exe"
export DIR_INPUT="input"
export DIR_OUTPUT="output"
export DIR_BUILD="build"
export DIR_EXTERNAL="external"
export DIR_SCRIPTS="scripts"
export DIR_LOG="log"
export DIR_RUN_TIME_CONFIG="run_time_config"

export LOG_container_compile="$DIR_ROOT/$DIR_LOG/start.log"
export PATH_DONE_install="${DIR_RUN_TIME_CONFIG}/DONE_installed.txt"

export CALLING_ARGUMENTS="$@"

export PICO_SDK_FETCH_FROM_GIT=1
export PICO_SDK_FETCH_FROM_GIT_PATH="$DIR_ROOT/$DIR_EXTERNAL"

# kontenery z bind-mountem muszą działać jako użytkownik hosta, inaczej wszystko
# co utworzą w mouncie (build/, exe/, external/) należy na hoście do root-a
# HOME - kontener nie ma /etc/passwd dla tego UID, więc cmake/git potrzebują zapisywalnego HOME
DOCKER_HOST_USER=(--user "$(id -u):$(id -g)" --env HOME=/tmp)


function silent_come_back() { cd - > /dev/null; };                              export -f silent_come_back
function clear_file() { if [ -f $1 ]; then rm -rf $1; fi; };                    export -f clear_file
function clear_file_nested() { cd $1; clear_file "$2"; silent_come_back; };     export -f clear_file_nested
function clear_dir() { if [ -d $1 ]; then rm -rf $1; fi; mkdir $1; };           export -f clear_dir
function clear_dir_nested() { cd $1; clear_dir "$2"; silent_come_back; };       export -f clear_dir_nested
function create_dir() { if [ ! -d $1 ]; then mkdir $1; fi; };                   export -f create_dir
function create_dir_nested() { cd $1; create_dir "$2"; silent_come_back; };     export -f create_dir_nested
